{
  "_note": [
    "游戏内：「技能选择」三选一，按 G 打开面板 → 双击中间那张卡 → 技能到手（面板自动关闭）",
    "",
    "用户 2026-11-16 00:15 实测（N7 第 1 波）：",
    "  按 G        → 弹出三张技能卡（多重射 SR / 野兽群 / 冰球术）",
    "  双击卡中心   → 左下提示「获得技能 野兽群」，面板关闭",
    "  连做 3 轮：3 次都成功（野兽群 / 中间卡 / 暗炮）",
    "",
    "坐标来源：用户截图里标的「2」= 中间那张卡（野兽群）的位置，",
    "  截图整窗 1706x960 缩放 0.633 后 (549,352) → 客户区 (840,338)；",
    "  用 1690x921 客户区实测命中，卡片就是那块 (730..950, 108..400) 的区域。",
    "",
    "为什么双击中间卡：三张卡随机，中间那张是用户指定的「2」号位（优先顺手的那张）。",
    "",
    "面板是否出现的判据（人工观察用）：中间卡区域 (730..950,108..400) 深色像素占比",
    "  有卡 ≈ 0.80 / 无卡 ≈ 0.09，阈值取 0.4。引擎里若要做条件判断可参考这个数。",
    "",
    "运行： run.bat run --config configs\\wuxia_skill.json --task pick_skill --autostart"
  ],
  "window": {
    "exe": ["War3.exe", "Warcraft III.exe", "y3.exe"],
    "title_re": ["Warcraft"],
    "min_size": 400
  },
  "capture": "auto",
  "humanize": true,
  "click_jitter": 0,
  "template_dir": "templates",
  "start_task": "pick_skill",
  "hotkeys": { "start_pause": "f8", "stop": "f9", "panic": "f11" },
  "tasks": {
    "pick_skill": {
      "_note": "按 G 开技能面板 → 双击中间卡（用户标的2号位）→ 循环 3 次",
      "repeat": 1,
      "steps": [
        { "log": "技能三选一：G → 双击中间卡，循环 3 次" },
        { "loop": {
            "count": 3,
            "gap": 800,
            "steps": [
              { "focus": true },
              { "wait": 400 },
              { "key": "g" },
              { "wait": 1500 },
              { "click": { "x": 840, "y": 338, "clicks": 2 } },
              { "wait": 1500 }
            ]
        }},
        { "log": "✅ 3 轮技能选择已完成" }
      ]
    },

    "pick_once": {
      "_note": "只选一次（调试用）",
      "repeat": 1,
      "steps": [
        { "focus": true },
        { "wait": 400 },
        { "key": "g" },
        { "wait": 1500 },
        { "click": { "x": 840, "y": 338, "clicks": 2 } },
        { "wait": 1500 }
      ]
    }
  }
}
