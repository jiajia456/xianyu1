{
  "_note": [
    "游戏内：「奇遇 / 新手套」装备三选一 —— 按 F 打开面板 → 双击其中一张卡 → 装备到手、面板关闭",
    "",
    "用户 2026-11-16 00:26 教的操作（截图里标了 1/2/3 三张卡：新手套 / 新手盔 / 新法袍，D 级）：",
    "  按 F  → 弹出三张 D 级装备卡（卡片标题「新手套(0/3)」这类，底部有「收起」）",
    "  双击卡 → 卡片消失、面板关闭，装备进背包（新手套 0/3 → 1/3）",
    "  连做 4 轮全部成功（每轮按 F 都会弹新的可选装备）",
    "",
    "坐标换算：用户截图是整窗 1706x960 缩放 0.633；标号「1/2/3」在客户区约",
    "  1=(524,482)  2=(859,482)  3=(1185,482)   —— 三张卡时卡中心 x 实测 560 / 889 / 1217",
    "",
    "重要：卡片数量会变（有时 1 张、有时 2 张、有时 3 张），固定用「1号位」会点到空处。",
    "  实测 (800,490) 在三种布局下都落在卡片内：三卡时=中间卡、两卡时=左卡、单卡时=中间卡。",
    "  所以下面统一点 (800,490)，不区分卡号。",
    "",
    "面板是否打开的判据：中间区域 (760..1000, 120..380) 深色像素占比 有面板≈0.8 / 无≈0.08。",
    "",
    "运行： run.bat run --config configs\\wuxia_equip.json --task pick_equip --autostart"
  ],
  "window": {
    "exe": ["War3.exe", "Warcraft III.exe", "y3.exe"],
    "title_re": ["Warcraft"],
    "min_size": 400
  },
  "capture": "auto",
  "humanize": true,
  "click_jitter": 0,
  "template_dir": "templates",
  "start_task": "pick_equip",
  "hotkeys": { "start_pause": "f8", "stop": "f9", "panic": "f11" },
  "tasks": {
    "pick_equip": {
      "_note": "按 F 开装备三选一 → 双击卡片 → 循环 4 次",
      "repeat": 1,
      "steps": [
        { "log": "装备三选一：F → 双击卡片，循环 4 次" },
        { "loop": {
            "count": 4,
            "gap": 900,
            "steps": [
              { "focus": true },
              { "wait": 400 },
              { "key": "f" },
              { "wait": 1800 },
              { "click": { "x": 800, "y": 490, "clicks": 2 } },
              { "wait": 1500 }
            ]
        }},
        { "log": "✅ 4 轮装备选择已完成" }
      ]
    },

    "upgrade_weapon": {
      "_note": "右键装备栏第 1 格（新手弓）双击 3 次 = 成长神器连升。格子中心 (1151,750)；金币不足时游戏会飘红字「金币不足」",
      "repeat": 1,
      "steps": [
        { "log": "右键双击装备 1 号格，循环 3 次" },
        { "loop": {
            "count": 3,
            "gap": 1200,
            "steps": [
              { "focus": true },
              { "wait": 300 },
              { "move": [380, 700] },
              { "wait": 200 },
              { "click": { "x": 1151, "y": 750, "button": "right", "clicks": 2, "hold": 40 } },
              { "wait": 1200 }
            ]
        }},
        { "log": "✅ 右键双击 3 次完成" }
      ]
    },

    "upgrade_weapon_burst": {
      "_note": "快速版：一次按住右键连点 12 下（约等于点 12 次升级），每轮之间停 1.3 秒",
      "repeat": 1,
      "steps": [
        { "focus": true },
        { "wait": 300 },
        { "move": [380, 700] },
        { "click": { "x": 1151, "y": 750, "button": "right", "clicks": 12, "hold": 40 } },
        { "wait": 1200 }
      ]
    },

    "pick_equip_once": {
