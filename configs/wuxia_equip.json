      "repeat": 1,
      "steps": [
        { "focus": true },
        { "wait": 400 },
        { "key": "f" },
        { "wait": 1800 },
        { "click": { "x": 800, "y": 490, "clicks": 2 } },
        { "wait": 1500 }
      ]
    }
  }
